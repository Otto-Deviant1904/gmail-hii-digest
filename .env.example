# Copy this file to `.env` and adjust. Every setting is optional.

# The word you email yourself to request a digest (case-insensitive, exact match).
HII_TRIGGER_WORD=hii

# "Today" = since local midnight in this IANA timezone.
HII_TIMEZONE=Australia/Melbourne

# Seconds between Gmail checks in `run` mode.
HII_POLL_INTERVAL=20

# How many emails to include in the digest.
HII_TOP_N=10

# Only answer trigger emails received within this many hours.
HII_TRIGGER_LOOKBACK_HOURS=24

# Upper bound on how many of today's emails are fetched and scored.
HII_MAX_CANDIDATES=150

# Upper bound on how many candidate trigger emails are inspected per check.
HII_MAX_TRIGGERS=25

# OAuth files (paths are relative to the folder you run the app from).
HII_CREDENTIALS_FILE=credentials.json
HII_TOKEN_FILE=token.json

# Gmail labels the app manages (created automatically if missing).
HII_HANDLED_LABEL=hii-digest/handled
HII_DIGEST_LABEL=hii-digest/sent

# Log level: DEBUG, INFO, WARNING, ERROR
HII_LOG_LEVEL=INFO

# --- Optional LLM summaries (OpenAI or any OpenAI-compatible API) ---
# Leave OPENAI_API_KEY empty to use the built-in, offline summariser.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# Seconds before an LLM request is abandoned (falls back to offline summaries).
# HII_LLM_TIMEOUT=30
